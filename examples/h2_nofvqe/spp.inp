logging = debug
mode = ab-initio
use_db = no

[mode(ab-initio)]
software = IntNOFVQE

[mode(ab-initio)::software(IntNOFVQE)]
chg = 0
mult = 1
basis = sto-3g
functional = pnof4
conv_tol = 1.0e-6
max_iterations = 500
gradient = analytics

[mode(ab-initio)::software(IntNOFVQE)::gradient(analytics)]
analytics_grad = True

[use_db(no)]
